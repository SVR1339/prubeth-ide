      {
        "id": "dbaeumer.vscode-eslint",
        "displayName": "ESLint",
        "description": "ESLint JavaScript linter integration",
        "tier": "core"
      },
      {
        "id": "svelte.svelte-vscode",
        "displayName": "Svelte for VS Code",
        "description": "Svelte language support",
        "tier": "frontend"
      },
      {
        "id": "Vue.volar",
        "displayName": "Vue - Official",
        "description": "Vue 3 language support with Volar",
        "tier": "frontend"
      },
      {
        "id": "ms-vscode.vscode-typescript-next",
        "displayName": "TypeScript Nightly",
        "description": "Latest TypeScript language service",
        "tier": "core"
      },
      {
        "id": "streetsidesoftware.code-spell-checker",
        "displayName": "Code Spell Checker",
        "description": "Spell checker for code and documents",
