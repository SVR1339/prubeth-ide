      },
      {
        "id": "golang.go",
        "displayName": "Go",
        "description": "Rich Go language support",
        "tier": "core"
      },
      {
        "id": "redhat.vscode-yaml",
        "displayName": "YAML",
        "description": "YAML language support with schema validation",
        "tier": "core"
      },
      {
        "id": "ms-vscode-remote.remote-ssh",
        "displayName": "Remote - SSH",
        "description": "Edit files on any remote machine using SSH",
        "tier": "remote"
      },
      {
        "id": "ms-vscode.remote-explorer",
        "displayName": "Remote Explorer",
        "description": "View remote machines for SSH and Tunnels",
        "tier": "remote"
      },
      {
        "id": "GitHub.vscode-pull-request-github",
        "displayName": "GitHub Pull Requests",
        "description": "Review and manage GitHub pull requests from the editor",
