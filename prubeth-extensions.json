      },
      {
        "id": "rust-lang.rust-analyzer",
        "displayName": "rust-analyzer",
        "description": "Official Rust language server with inlay hints and refactoring",
        "tier": "core"
      },
      {
        "id": "esbenp.prettier-vscode",
        "displayName": "Prettier",
        "description": "Multi-language opinionated code formatter",
        "tier": "core"
      },
      {
        "id": "eamodio.gitlens",
        "displayName": "GitLens",
        "description": "Supercharged Git with blame, history, and commit graph",
        "tier": "core"
      },
      {
        "id": "ms-azuretools.vscode-docker",
        "displayName": "Docker",
        "description": "Build, manage, and deploy containerized applications",
        "tier": "core"
      },
      {
        "id": "usernamehw.errorlens",
        "displayName": "Error Lens",
        "description": "Inline error and warning messages in the editor",
        "tier": "productivity"
      },
      {
        "id": "PKief.material-icon-theme",
        "displayName": "Material Icon Theme",
        "description": "File and folder icon theme based on Material Design",
        "tier": "ui"
      },
      {
        "id": "enkia.tokyo-night",
