        "description": "Dark theme inspired by Tokyo's night aesthetic",
        "tier": "ui"
      },
      {
        "id": "ms-vscode.cpptools",
        "displayName": "C/C++",
        "description": "C and C++ IntelliSense, debugging, and code browsing",
